# ------------------------------------------------------------------
# Copier ce fichier en .env.local (développement) et renseigner les
# mêmes variables dans Vercel : Project → Settings → Environment Variables
# ------------------------------------------------------------------

# === Formulaire de contact — envoi via la boîte mail One.com =========

# Serveur SMTP One.com (authentifié, utilisable depuis Vercel)
SMTP_HOST=send.one.com
# 587 = STARTTLS (recommandé) · 465 = SSL
SMTP_PORT=587

# Boîte mail qui envoie (doit exister chez One.com) et son mot de passe
SMTP_USER=info@carbike.be
SMTP_PASS=

# Destinataire des messages : par défaut, l'e-mail saisi dans l'espace admin.
# Ne définir CONTACT_TO que pour forcer une autre adresse (elle passe alors avant celle de l'admin).
# CONTACT_TO=

# En local, laisser SMTP_HOST vide : les messages sont affichés dans le terminal au lieu d'être envoyés.

# === Espace d'administration (/admin) ===============================

# Empreinte du mot de passe (jamais le mot de passe lui-même) :
#   npm run admin:hash -- "le mot de passe"
ADMIN_PASSWORD_HASH=

# Clé de signature des sessions (32 caractères minimum) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Jeton du store Vercel Blob (photos, logos, contenu modifiable).
# Ajouté automatiquement par Vercel quand le store est relié au projet ;
# en local : npx vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
