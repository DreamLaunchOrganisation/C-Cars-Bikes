# ------------------------------------------------------------------
# Formulaire de contact — envoi via la boîte mail One.com de l'atelier
# Copier ce fichier en .env.local (développement) et renseigner les
# mêmes variables dans Vercel : Project → Settings → Environment Variables
# ------------------------------------------------------------------

# Serveur SMTP One.com (authentifié, utilisable depuis Vercel)
SMTP_HOST=send.one.com
# 587 = STARTTLS (recommandé) · 465 = SSL
SMTP_PORT=587

# Boîte mail qui envoie (doit exister chez One.com) et son mot de passe
SMTP_USER=info@carbike.be
SMTP_PASS=

# Adresse qui reçoit les messages du formulaire
CONTACT_TO=info@carbike.be

# En local, laisser SMTP_HOST vide : les messages sont affichés dans le terminal au lieu d'être envoyés.
